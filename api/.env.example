# Copy to .env and fill in values:
#   cp .env.example .env

# --- Auth (required for non-dev / Google OAuth) ---
# Session signing secret. Change this in any shared or production deploy.
AUTH_SECRET=dev-secret-change-me

# Shared API database (auth + future app tables). Postgres only.
# AUTH_DATABASE_URL is still accepted as a fallback.
# Docker Compose sets POSTGRES_* and /entrypoint builds DATABASE_URL from them:
#   postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Local Postgres (no Docker):
DATABASE_URL=postgresql+psycopg://agenthub:agenthub@localhost:5432/agenthub

# Public base URL of the auth router (no trailing slash).
# Google OAuth redirect URI is derived as: ${AUTH_BASE_URL}/oauth/callback/google
# Example for local: http://localhost:8000/api/auth/oauth/callback/google
AUTH_BASE_URL=http://localhost:8000/api/auth

# Where to send the browser after OAuth / sign-in (frontend).
AUTH_FRONTEND_CALLBACK=http://localhost:3000

# Session cookie lifetime in minutes (default: 7 days).
# AUTH_SESSION_EXPIRES_MINUTES=10080

# Set to true behind HTTPS so the session cookie gets Secure.
# AUTH_COOKIE_SECURE=false

# Google OAuth (optional). Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v2/userinfo
# GOOGLE_SCOPES=openid email profile

# --- HTTP / CORS ---
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Bind address/port when running `python main.py` (uvicorn defaults still apply via CLI).
# HOST=0.0.0.0
# PORT=8000

# --- Sandbox / registry ---
# MSB_IMAGE=node
# REGISTRY_DIR=../registry

# SESSION_IDLE_TIMEOUT=1800
# SESSION_MAX_DURATION=3600
# SESSION_BASE_PORT=10000
