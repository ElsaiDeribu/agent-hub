{
  "protocol": "chat",
  "evalConfig": {
    "timeoutMs": 10000
  },
  "evaluators": [
    { "type": "contains", "weight": 1.0 },
    { "type": "latency", "config": { "maxMs": 5000 } }
  ],
  "cases": [
    {
      "id": "hello-response",
      "name": "Responds to hello",
      "input": {
        "message": "Hello!"
      },
      "expected": {
        "contains": ["hello"]
      },
      "tags": ["basic"]
    },
    {
      "id": "what-can-you-do",
      "name": "Responds to capability question",
      "input": {
        "message": "What can you do?"
      },
      "expected": {
        "contains": ["hello"]
      },
      "tags": ["basic"]
    }
  ]
}
